<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app sandbox is off on purpose: the desktop app starts the bundled
	  daemon (Contents/MacOS/fundus) as a detached process and talks to it on
	  127.0.0.1, which a sandboxed app may not do. Outgoing network access is
	  still declared for the loopback connection and OAuth redirects.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
